# Copy this file to .env.local and fill in the real values.
# NEVER put real keys in this file. This file is committed to Git.

# Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase public key (the dashboard may label it "anon" or "publishable").
# Safe for the browser ONLY because Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=